{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec/contracts/behavior-fixture-manifest.schema.json",
  "title": "behavior-audit 隔离行为夹具清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "platform_selector",
    "model_selector",
    "scope_selector",
    "isolation_profile",
    "execution_provider",
    "authorization",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0-candidate"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_digest"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "platform_selector": {
      "type": "string",
      "minLength": 1
    },
    "model_selector": {
      "type": "string",
      "minLength": 1
    },
    "scope_selector": {
      "type": "string",
      "minLength": 1
    },
    "isolation_profile": {
      "type": "object",
      "description": "调用方提供的执行隔离事实；Audit 只消费，不定义通用隔离合同。"
    },
    "execution_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_version",
        "proof_path",
        "proof_digest"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "proof_path": {
          "type": "string",
          "minLength": 1
        },
        "proof_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "receipt_path",
        "receipt_digest",
        "authorized_fixture_ids",
        "expires_at"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorized_fixture_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "category",
          "argv",
          "executable_digest",
          "cwd",
          "timeout_seconds",
          "environment",
          "write_set",
          "expected"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "category": {
            "enum": [
              "normal",
              "negative",
              "missing",
              "boundary",
              "failure",
              "blocked",
              "waiting",
              "degraded",
              "cross_platform",
              "cancel_late"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "executable_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cwd": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "environment": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "write_set": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exit_code",
              "stdout_digest",
              "stderr_digest",
              "output_files"
            ],
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "stdout_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "stderr_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_files": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "content_digest"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "content_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
