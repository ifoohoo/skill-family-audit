{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/plugin-project-observation.json",
  "title": "Skill Family Audit PluginProject observation",
  "description": "Audit 对单个 Skill 或含一个以上 Skill 的插件所做的最小只读观察；release scope 额外绑定候选身份与 payload 摘要。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "skills", "projections"],
  "properties": {
    "schemaVersion": {"const": "1.0.0-candidate"},
    "scope": {"enum": ["skill", "plugin", "release"]},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "manifest": {"type": ["string", "null"]}
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "manifest", "mappings"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "minLength": 1},
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["skillId", "path"],
              "properties": {
                "skillId": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "payloadDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "payloadDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "skill"}}},
      "then": {"properties": {"skills": {"type": "array", "maxItems": 1}}}
    },
    {
      "if": {"properties": {"scope": {"enum": ["plugin", "release"]}}},
      "then": {"required": ["plugin"], "properties": {"plugin": true}}
    },
    {
      "if": {"properties": {"scope": {"const": "release"}}},
      "then": {"required": ["candidate"], "properties": {"candidate": true}}
    }
  ]
}
