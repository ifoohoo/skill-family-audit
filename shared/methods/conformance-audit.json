{
  "schemaVersion": "1.0.0-candidate",
  "methodId": "skill-family-audit:conformance-audit",
  "name": "规范符合性检查",
  "description": "覆盖单个技能轻量检查、技能族源码完整检查、发行包检查和目标项目采用检查；组合确定性扫描与必要语义审阅",
  "capability": {
    "capabilityRef": "cap:skill-family-audit.family",
