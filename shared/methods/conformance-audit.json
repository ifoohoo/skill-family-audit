    "不得遗漏强制规则"
  ],
  "businessLabels": [
    "skill_family",
    "skill_specification",
    "skill_rule",
    "skill_assessment"
  ],
  "strictIOBinding": {
    "foundationProfile": {
      "id": "quickstart-profile",
      "version": 1,
      "taskContract": "https://contracts.skill-family.example/candidate/quickstart-profile/v1/task.json",
      "resultContract": "https://contracts.skill-family.example/candidate/quickstart-profile/v1/result.json"
