        "evidence_list": {
          "type": "array",
          "items": {},
          "description": "符合性审计领域证据"
        },
        "remediation_plan": {
          "type": "array",
          "items": {},
          "description": "修复建议"
        }
      },
      "required": [
        "conformance_result",
        "rule_findings",
        "evidence_list",
        "remediation_plan"
      ],
      "additionalProperties": false
    }
