{
  "schemaVersion": "1.0.0-candidate",
  "methodId": "skill-family-audit:behavior-audit",
  "name": "行为验证",
  "description": "在隔离环境中真实安装并黑盒执行代表样例；拥有独立的权限、成本、清理和验收契约",
  "capability": {
    "capabilityRef": "cap:skill-family-audit.family",
    "capabilityDigest": "sha256:54c90ac1376e46fd6e1244e8932bd0893ab98d9cf40d11de180e98dad1b7548d",
    "methodSlice": "在明确平台、模型、样例和限制下，验证技能族行为是否满足业务验收"
  },
  "accepts": [
    "immutable_artifact_ref",
    "artifact_digest",
    "install_provider",
    "install_authorization",
    "target_project_path",
    "fixture_manifest",
    "platform_selector",
    "model_selector",
    "scope_selector"
  ],
  "produces": [
    "behavior_result",
    "execution_records",
    "evidence_list",
    "regression_record"
  ],
  "artifactTypes": [
    "skill_family",
    "skill_capability",
    "skill_method_contract",
    "skill_assessment"
  ],
  "sideEffects": [
    "write-project-artifacts"
  ],
  "idempotency": "checkpoint_recoverable",
  "composability": "closed_leaf",
  "executionEnvironment": {
    "isolation": "mandatory_minimum_profile",
    "codeExecution": true,
    "note": "behavior-audit 只能在最低隔离画像内执行目标"
  },
  "maturity": "experimental",
  "status": "candidate",
  "created_at": "2026-07-20T00:00:00+08:00",
  "permissions": {
    "read": true,
    "create": true,
    "modify": false,
    "overwrite": false,
    "delete": false,
    "move": false,
    "execute_command": true,
    "install_dependency": true,
    "network_read": true,
    "external_write": false,
    "key_reference": false,
    "publish": false
  },
  "costBudget": {
    "estimated_tokens": 200000,
    "max_wall_seconds": 3600,
    "budget_ref": "spec/contracts/budget.schema.json"
  },
  "acceptanceCriteria": [
    "样例在隔离环境成功执行",
    "执行记录包含输入输出",
    "副作用已清理",
    "证据绑定运行身份"
  ],
  "errorCategories": [
    "INPUT_INVALID",
    "INPUT_MISSING",
    "DEPENDENCY_UNAVAILABLE",
    "EXECUTION_EXCEPTION",
    "SIDE_EFFECT_UNKNOWN"
  ],
  "businessLabels": [
    "skill_family",
    "skill_capability",
    "skill_method_contract",
    "skill_assessment"
  ],
  "compositionConstraints": {
    "applicable": false,
    "note": "composability is closed_leaf; composition constraints not applicable"
  },
  "strictIOBinding": {
    "taskContract": "spec/contracts/task.schema.json",
    "resultContract": "spec/contracts/result.schema.json",
    "taskRevisionDigest": "d1fcc6ac0d229b3a8f12bba6b662f113bd61f0adcb891fa1ede45a5ec0c8309f",
    "resultRevisionDigest": "d9e0155a14ac757abce4c463595245c745e08c81841a7f6994626d5ba640d792",
    "note": "本方法为注册的严格业务方法；accepts/produces 槽位经公共任务/结果契约交接，不另建输入输出真源。taskRevisionDigest/resultRevisionDigest 精确绑定注册边界锁定的任务/结果契约真实内容摘要。",
    "parameterSchema": {
      "type": "object",
      "properties": {
        "immutable_artifact_ref": {
          "type": "string",
          "description": "不可变发行物目录或归档引用"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "安装前必须匹配的发行物 SHA-256 树摘要"
        },
        "install_provider": {
          "type": "string",
          "description": "隔离环境安装提供者身份及版本"
        },
        "install_authorization": {
          "type": "string",
          "description": "平台和提供者绑定的显式安装授权引用"
        },
        "target_project_path": {
          "type": "string",
          "description": "方法级输入参数 target_project_path"
        },
        "fixture_manifest": {
          "type": "object",
          "description": "方法级输入参数 fixture_manifest"
        },
        "platform_selector": {
          "type": "string",
          "description": "方法级输入参数 platform_selector"
        },
        "model_selector": {
          "type": "string",
          "description": "方法级输入参数 model_selector"
        },
        "scope_selector": {
          "type": "string",
          "description": "方法级输入参数 scope_selector"
        }
      },
      "required": [
        "immutable_artifact_ref",
        "artifact_digest",
        "install_provider",
        "install_authorization",
        "target_project_path",
        "fixture_manifest",
        "platform_selector",
        "model_selector",
        "scope_selector"
      ],
      "additionalProperties": false
    },
    "installedInvocation": {
      "description": "发行物安装完成后，由已安装 Quickstart 为严格 behavior_audit.py 入口规范化的内部执行阶段；它只投影公开 accepts 中由严格入口直接消费的业务字段，不改变公开方法签名。",
      "script": "behavior_audit.py",
      "parameterSchema": {
        "type": "object",
        "properties": {
          "target_project_path": {
            "type": "string",
            "description": "严格行为审计目标项目绝对路径"
          },
          "fixture_manifest": {
            "type": "object",
            "description": "严格行为审计样例清单对象"
          },
          "platform_selector": {
            "type": "string",
            "description": "严格行为审计目标平台"
          },
          "model_selector": {
            "type": "string",
            "description": "严格行为审计模型选择"
          },
          "scope_selector": {
            "type": "string",
            "description": "严格行为审计范围选择"
          }
        },
        "required": [
          "target_project_path",
          "fixture_manifest",
          "platform_selector",
          "model_selector",
          "scope_selector"
        ],
        "additionalProperties": false
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "behavior_result": {
          "$ref": "spec/contracts/result.schema.json#/properties/domain_results/items",
          "description": "领域结果引用 behavior_result（经 result.domain_results 交接，原样追加一个元素）"
        },
        "execution_records": {
          "type": "array",
          "items": {
            "$ref": "spec/contracts/result.schema.json#/properties/outputs/items"
          },
          "description": "输出资源 execution_records（经 result.outputs 交接，原样追加全部元素）"
        },
        "evidence_list": {
          "type": "array",
          "items": {
            "$ref": "spec/contracts/result.schema.json#/properties/evidence/items"
          },
          "description": "证据引用 evidence_list（经 result.evidence 交接，原样追加全部元素）"
        },
        "regression_record": {
          "type": "array",
          "items": {
            "$ref": "spec/contracts/result.schema.json#/properties/outputs/items"
          },
          "description": "输出资源 regression_record（经 result.outputs 交接，原样追加全部元素）"
        }
      },
      "required": [
        "behavior_result",
        "execution_records",
        "evidence_list",
        "regression_record"
      ],
      "additionalProperties": false
    },
    "slotMapping": {
      "accepts": {
        "immutable_artifact_ref": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/immutable_artifact_ref"
        },
        "artifact_digest": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/artifact_digest"
        },
        "install_provider": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/install_provider"
        },
        "install_authorization": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/install_authorization"
        },
        "target_project_path": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/target_project_path"
        },
        "fixture_manifest": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/fixture_manifest"
        },
        "platform_selector": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/platform_selector"
        },
        "model_selector": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/model_selector"
        },
        "scope_selector": {
          "container": "parameters",
          "pointer": "/properties/parameters",
          "memberPointer": "/properties/scope_selector"
        }
      },
      "produces": {
        "behavior_result": {
          "container": "domain_results",
          "pointer": "/properties/domain_results",
          "memberPointer": "/properties/behavior_result",
          "elementMapping": {
            "container": "domain_results",
            "memberRole": "element"
          }
        },
        "execution_records": {
          "container": "outputs",
          "pointer": "/properties/outputs",
          "memberPointer": "/properties/execution_records",
          "elementMapping": {
            "container": "outputs",
            "memberRole": "element_list"
          }
        },
        "evidence_list": {
          "container": "evidence",
          "pointer": "/properties/evidence",
          "memberPointer": "/properties/evidence_list",
          "elementMapping": {
            "container": "evidence",
            "memberRole": "element_list"
          }
        },
        "regression_record": {
          "container": "outputs",
          "pointer": "/properties/outputs",
          "memberPointer": "/properties/regression_record",
          "elementMapping": {
            "container": "outputs",
            "memberRole": "element_list"
          }
        }
      }
    }
  }
}
