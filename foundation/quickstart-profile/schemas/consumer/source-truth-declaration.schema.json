{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/source-truth-declaration.json",
  "title": "Skill family source authority declaration",
  "description": "项目根单一真源声明的 JSON 机器对象；只允许由 skill-family.source-authority.json 或 AGENTS.md/README.md 的具名 fenced JSON 承载。每条映射从源根集合和一个生成器机械派生目标根集合。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "mappings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.source-authority-declaration"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "containedPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "sourceRoots",
        "generatedRoots",
        "generator"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/containedPath"
          }
        },
        "generatedRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/containedPath"
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/containedPath"
            },
            "checkArgument": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
