{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-agent:schema:finalization-request",
  "type": "object",
  "required": [
    "schema_version",
    "nonce",
    "request_id",
    "run_id",
    "attempt_id",
    "child_process_id",
    "subject_id",
    "review_level",
    "recommendation_sha256",
    "criteria_manifest_digest",
    "postrun_state_hash",
    "parent_runtime_identity",
    "process_id",
    "delivery_task_id",
    "attempt_dir",
    "working_tree_sha256",
    "run_dir",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "run_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "child_process_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "subject_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "review_level": {
      "enum": [
        "vendor",
        "client"
      ]
    },
    "recommendation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "postrun_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_runtime_identity": {
      "type": "string",
      "pattern": "\\S"
    },
    "process_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "delivery_task_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "attempt_dir": {
      "type": "string",
      "pattern": "\\S"
    },
    "working_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_dir": {
      "type": "string",
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
