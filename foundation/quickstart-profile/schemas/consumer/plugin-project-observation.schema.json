{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/plugin-project-observation.json",
  "title": "Skill Family Audit PluginProject observation (v2)",
  "description": "Audit 对单个 Skill 或含一个以上 Skill 的插件所做的只读观察；release scope 额外绑定候选身份与 payload 摘要。v2（schemaVersion 2.0.0-candidate）合入 2026-08-18 审计确认的 A 类契约适配缺口（A-1~A-24）：多 manifest 与多打包根表达、插件三坐标身份、多点版本事实、技能 role/kind/visibility/注册边界、入口缺失与脚本型人类入口、平台受控词汇（含 qoder/dsh）与矩阵外分发面、平台子集意图与缺失平台、findings 观察结果区、仓库/分支/工作区状态、foundation 采用字段（轻量采用声明）、词元估算器身份与双口径测量、测试/CI、治理指针、发布控制面与公开边界、registry 事实占位、path 基准定义。向后兼容策略：v1（schemaVersion 1.0.0-candidate）记录在 v2 schema 下仍可校验通过——全部新增字段均为可选，skills/projections.mappings 的 minItems=1 放宽为 0，manifest 单值放宽为可空或列表；不满足 v2 新增表达需要的 v1 记录不产生迁移义务。additionalProperties 策略：各层保持 false（封闭词汇表），扩展只能经由本合同修订，避免回到自由正文塞字段。与 Skill Family Foundation Contracts 1.6.0 的对齐（observation scope 扩展对象）为引用占位：https://contracts.skill-family.example/skill-family-foundation/contracts/1.6.0/observation-scope ——Contracts 1.6.0 发布后以其权威 $id 为准对齐；candidate 段语义维持 v1 约定（plugin scope 不绑定 candidate，payloadDigest 仅 release scope 产生，A-20 维持现状即兼容解）。path 基准（A-22）：全部 path/relative_path 字段默认为项目根相对 POSIX 路径；v2 记录建议显式声明 pathBasis。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "skills",
    "projections"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0-candidate",
        "2.0.0-candidate"
      ],
      "description": "观察记录遵循的合同文档版本。1.0.0-candidate 记录继续有效；2.0.0-candidate 记录可使用 v2 新增字段。"
    },
    "scope": {
      "enum": [
        "skill",
        "plugin",
        "release"
      ]
    },
    "pathBasis": {
      "enum": [
        "project-root-relative"
      ],
      "description": "全部路径字段的基准目录声明（A-22）。缺省语义即 project-root-relative；v2 记录建议显式声明。"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "插件观察身份（v1 兼容字段）。包名/清单名/仓库名多坐标事实请填 identity；单一逻辑身份建议填平台中立逻辑标识。"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "版本（v1 兼容字段）。版本真源与多点分布事实请填 versions。"
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ],
          "description": "单一主清单路径（v1 兼容字段）。并列多清单请填 manifests。"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logicalId": {
              "type": "string",
              "minLength": 1,
              "description": "平台中立逻辑身份（如 family:plugin 逻辑名）。"
            },
            "packageName": {
              "type": "string",
              "minLength": 1,
              "description": "npm/包清单坐标（如 @scope/name）。"
            },
            "manifestName": {
              "type": "string",
              "minLength": 1,
              "description": "插件清单声明的名称。"
            },
            "repositoryName": {
              "type": "string",
              "minLength": 1,
              "description": "仓库坐标（如 owner/repo）。"
            }
          },
          "description": "插件三坐标身份事实（A-2：包名/清单名/仓库名分列表达）。全部可选，按在场事实填写。"
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "npm-package",
                  "plugin-manifest",
                  "host-manifest",
                  "adapter-manifest",
                  "marketplace-manifest",
                  "other"
                ],
                "description": "清单种类；marketplace-manifest 用于聚合市场条目（A-24）。"
              },
              "platform": {
                "type": "string",
                "minLength": 1,
                "description": "若清单专属某平台，填平台标识；否则省略。"
              }
            }
          },
          "description": "并列多 manifest 表达（A-1）：根级+adapter 内嵌、npm 多 package.json、双根级清单等按实枚举。"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "truthSource": {
              "type": "string",
              "minLength": 1,
              "description": "版本真源文件路径或机制说明。"
            },
            "authorities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "全部版本权威声明点（双权威/多点分布，A-3）。"
            },
            "distributionPoints": {
              "type": "integer",
              "minimum": 0,
              "description": "版本复写点计数（如 7 处版本文件）。"
            },
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "description": "历史候选归档形态（versions/ 目录、dist/candidate 冻结等）。"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "switcher": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ],
                  "description": "版本切换器存在性/身份。"
                }
              },
              "description": "历史候选归档事实（A-3）。"
            }
          },
          "description": "版本事实区（A-3：真源、多点分布、双权威、多包各自版本、历史归档）。"
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "技能枚举。v2 放宽 minItems：非插件对象（平台工程/CLI/npm 桌面应用）可合法置空，不再以夹具充数（A-7）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "技能根路径（项目根相对）。脚本型入口填脚本路径。"
          },
          "role": {
            "enum": [
              "human-entry",
              "strict-method",
              "internal",
              "fixture",
              "other"
            ],
            "description": "技能角色（A-4）：人类入口 / 严格方法 / internal / 夹具 / 其他。"
          },
          "kind": {
            "enum": [
              "skill-md",
              "script",
              "other"
            ],
            "description": "入口形态（A-6）：SKILL.md 技能或脚本型入口（setup.sh/quickstart 脚本等）。"
          },
          "visibility": {
            "enum": [
              "first-party",
              "third-party",
              "fixture",
              "unknown"
            ],
            "description": "可见性/归属（A-4：第一方与夹具区分）。"
          },
          "registration": {
            "enum": [
              "registered",
              "unregistered",
              "not-applicable"
            ],
            "description": "注册边界事实（A-5：存在但不注册 = unregistered）。"
          },
          "frontmatterName": {
            "type": "string",
            "minLength": 1,
            "description": "SKILL.md frontmatter name（含冒号逻辑名）。"
          },
          "physicalOf": {
            "type": "string",
            "minLength": 1,
            "description": "若本条目是某逻辑技能拆分的物理技能，填逻辑技能 id（A-4）。"
          }
        }
      }
    },
    "missingEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "form"
        ],
        "properties": {
          "entry": {
            "enum": [
              "help",
              "setup",
              "quickstart",
              "other"
            ],
            "description": "标准入口名。other 时以 note 说明。"
          },
          "form": {
            "enum": [
              "absent",
              "script-only",
              "present-unregistered"
            ],
            "description": "缺失形态（A-5/A-6）：不存在 / 仅以脚本存在 / 存在但不注册。"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "入口缺失表达区（A-5/A-6）：skills[] 只枚举存在物，缺失与降级形态在此登记。"
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "manifest",
          "mappings"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1,
            "description": "投影/分发面标识。标准平台取值受控词汇见 standardPlatform；矩阵外分发面以 surfaceClass 标注语义。"
          },
          "standardPlatform": {
            "enum": [
              "claude-code",
              "codex",
              "kimi-code",
              "workbuddy",
              "qoder",
              "dsh"
            ],
            "description": "受控平台词汇（A-11，承接 D-3 support-matrix 扩入 qoder/dsh）。qoder/dsh 为扩入项：dsh 当前零在场实证，其 support-matrix 状态取值（建议实验态）以 B6 条文与用户对开放项 1 的确认为准；取值确认后本词汇与 support-matrix 保持单一事实源引用关系。"
          },
          "surfaceClass": {
            "enum": [
              "platform-projection",
              "aggregate-marketplace",
              "host-shared",
              "migration-residue",
              "other"
            ],
            "description": "分发面语义分类（A-11/A-24）：发布投影 / 聚合市场 / 宿主共享面（无 manifest 降级发现）/ 迁移期遗留投影 / 其他。"
          },
          "entryClass": {
            "enum": [
              "plugin-manifest",
              "marketplace-manifest",
              "distribution-only"
            ],
            "description": "清单条目类别（A-24）：插件清单 / 市场清单 / 纯分发（无技能映射）。"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "description": "打包根路径（A-9：同平台多打包根时每条 projection 各自的根，如根级与 adapters/<平台>/）。"
          },
          "manifest": {
            "type": [
              "string",
              "null"
            ],
            "description": "投影清单路径；无清单的分发面（如宿主共享 skills/ 降级发现）填 null（A-8/A-12）。"
          },
          "mappings": {
            "type": "array",
            "description": "逻辑技能映射。v2 放宽 minItems：无技能映射的纯分发清单可为空数组（A-8）。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "path"
              ],
              "properties": {
                "skillId": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "generated": {
                "type": "boolean",
                "description": "是否生成物（false=手写双副本）。"
              },
              "generator": {
                "type": "string",
                "minLength": 1,
                "description": "生成器身份（如 build_adapters.py、投影工具链）。"
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1,
                "description": "模板源/逻辑根路径（如 SKILL.md.tpl）。"
              },
              "invariant": {
                "type": "string",
                "minLength": 1,
                "description": "投影不变量或逻辑根摘要说明。"
              }
            },
            "description": "源-生成物谱系（A-10）。"
          }
        }
      }
    },
    "platformCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declaredPlatforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "项目如实声明的发布平台子集（承接 D-9：平台覆盖可选，强制项是如实声明子集）。"
        },
        "missingPlatforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "intent"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "claude-code",
                  "codex",
                  "kimi-code",
                  "workbuddy",
                  "qoder",
                  "dsh"
                ],
                "description": "缺失平台（受控词汇）。"
              },
              "intent": {
                "enum": [
                  "unsupported",
                  "planned",
                  "experimental",
                  "deprecated-host"
                ],
                "description": "缺失意图状态（A-12）：不支持 / 计划中 / 实验 / 宿主已弃用。"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "缺失平台与意图登记（A-12/D-10）。"
        },
        "policyNote": {
          "type": "string",
          "minLength": 1,
          "description": "平台子集政策说明（如标准限制声明模板引用）。"
        }
      },
      "description": "平台覆盖意图区（A-12）。"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "naming-deviation",
              "rule-effect-status",
              "contract-gap",
              "platform-gap",
              "adoption",
              "other"
            ],
            "description": "观察发现类别（A-13：命名偏离、规则效力状态、契约缺口等）。"
          },
          "severity": {
            "enum": [
              "block",
              "error",
              "warning",
              "observe"
            ],
            "description": "严重度（与规则违反影响词汇对齐）。"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "关联规则 id、差异登记号或证据路径。"
          }
        }
      },
      "description": "观察结果区（A-13）：只读观察层面的发现登记，不构成整改台账。"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "description": "当前分支（A-14：非 main 分支事实）。"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "dirtyCount": {
          "type": "integer",
          "minimum": 0,
          "description": "未提交改动计数。"
        },
        "dirtyBreakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modified": {
              "type": "integer",
              "minimum": 0
            },
            "untracked": {
              "type": "integer",
              "minimum": 0
            },
            "staged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "embeddedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "内嵌仓结构（路径枚举）。"
        }
      },
      "description": "仓库/分支/工作区状态区（A-14）。"
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "foundation-adopted",
            "self-built",
            "exempted",
            "not-adopted",
            "unknown"
          ],
          "description": "foundation 采用状态（A-15/D-8/D-11）。exempted=已登记自建豁免（豁免登记契约由 B-δ 承载，见 exemptionRef）。"
        },
        "declarationPath": {
          "type": "string",
          "minLength": 1,
          "description": "轻量采用声明文件路径（合同 project-adoption-declaration；取代已废弃的 adoption-lock）。"
        },
        "foundationProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "stability": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "foundationPin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "description": "pin 钉扎事实。digest 适用 GK-4 实文件比对纪律（见 project-adoption-declaration 合同条文）。"
        },
        "contractsVersion": {
          "type": "string",
          "minLength": 1,
          "description": "所钉扎 foundation Contracts 版本（零消费/未钉扎时省略并以 status 表达）。"
        },
        "consumptionForm": {
          "enum": [
            "dependencies",
            "vendored-bundle",
            "tarball-pin",
            "none",
            "other"
          ],
          "description": "消费形态（A-15：dependencies、vendored bundle、tarball 钉扎、零消费）。"
        },
        "exemptionRef": {
          "type": "string",
          "minLength": 1,
          "description": "自建豁免登记记录引用（豁免登记契约文件名由 B-δ 决定；此处只记引用占位，登记点见 governance/adjudication/spec-revisions/B-epsilon.md）。"
        }
      },
      "description": "foundation 采用字段区（A-15/D-29~D-32）。正式机器契约对齐 Foundation Contracts 1.6.0 profile 采用声明对象（引用占位，见顶层 description）。"
    },
    "tokenBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "词元估算器身份（A-16，SFA-CONTEXT-028 登记要求：名称+版本；权威估算器由 foundation C1 提供后引用）。"
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "tokens"
            ],
            "properties": {
              "subject": {
                "enum": [
                  "logical-source",
                  "worst-projection"
                ],
                "description": "测量对象双口径（逻辑源 / 最坏投影，承接 D-7/B5）。"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "thresholdWarning": {
                "type": "integer",
                "minimum": 0
              },
              "thresholdHard": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "overLimit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "超线路径清单（阈值保留 2000/2400；估算器落地前只作证据）。"
        }
      },
      "description": "词元统计/预算/估算器身份区（A-16/D-18~D-20）。"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testEntrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "测试入口清单（含存根事实）。"
        },
        "ciGates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "CI 门禁清单（A-17）。"
        },
        "integrityPins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "integrity 钉扎事实。"
        }
      },
      "description": "测试/CI/integrity 区（A-17/D-27）。"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tightening": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "治理指针区（A-18/D-33~D-35）：治理决断、例外台账、自加严记录、豁免的引用指针（路径/登记号），不重述内容。"
    },
    "releaseControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPlanePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "发布控制面路径（.release-skill/、control/、evidence/ 等）。"
        },
        "publicBoundaryMechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "公开边界声明机制（public-release.json / project.yaml / files+publicFiles 等）。"
        },
        "stateMachineStates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "发布状态机在场状态（如 CANDIDATE_QUALIFIED）。"
        },
        "structure": {
          "enum": [
            "single-package",
            "parent-workspace-plus-public-package",
            "other"
          ],
          "description": "发布结构（父工作区/公开包双层等）。"
        }
      },
      "description": "发布控制面/公开边界声明区（A-19/D-21/D-23）。"
    },
    "registryFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement"
        ],
        "properties": {
          "registryId": {
            "type": "string",
            "minLength": 1
          },
          "entryCount": {
            "type": "integer",
            "minimum": 0
          },
          "kindDistribution": {
            "type": "object"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "registry/方法注册事实占位区（A-21/D7）。正式承载为 registry-projection 契约（SG-22 提案待用户裁决与生态对齐，见交接单 B12）；在正式契约落地前本区仅作只读事实占位，kindDistribution 暂不封闭。"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "payloadDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "候选绑定段（仅 release scope；语义与 v1 一致，A-20 不改变）。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "skill"
          }
        }
      },
      "then": {
        "properties": {
          "skills": {
            "type": "array",
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "enum": [
              "plugin",
              "release"
            ]
          }
        }
      },
      "then": {
        "required": [
          "plugin"
        ],
        "properties": {
          "plugin": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "release"
          }
        }
      },
      "then": {
        "required": [
          "candidate"
        ],
        "properties": {
          "candidate": true
        }
      }
    }
  ]
}
