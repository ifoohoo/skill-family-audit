{
  "title": "Adoption Report",
  "description": "JSON Schema for machine-verifiable adoption level reports. A single report declares exactly one of three mutually exclusive outcomes: v1_compatible, v2_adopted, or failed.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    { "$ref": "#/$defs/v1CompatibleReport" },
    { "$ref": "#/$defs/v2AdoptedReport" },
    { "$ref": "#/$defs/failedReport" }
  ],
  "$defs": {
    "v1CompatibleReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "level", "packageVersion", "v1Evidence"],
      "properties": {
        "qualified": { "const": true },
        "level": { "const": "v1_compatible" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "v1Evidence": { "$ref": "#/$defs/v1Evidence" }
      }
    },
    "v2AdoptedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "level", "packageVersion", "v1Evidence", "v2Evidence"],
      "properties": {
        "qualified": { "const": true },
        "level": { "const": "v2_adopted" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "v1Evidence": { "$ref": "#/$defs/v1Evidence" },
        "v2Evidence": { "$ref": "#/$defs/v2Evidence" }
      }
    },
    "failedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "packageVersion", "diagnostics"],
      "properties": {
        "qualified": { "const": false },
        "packageVersion": { "type": "string", "minLength": 1 },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locatableDiagnostic" }
        }
      }
    },
    "v1Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageInstalled", "sevenFunctionsReturn", "cliQueryResolve", "typescriptCompatible"],
      "properties": {
        "packageInstalled": { "const": true },
        "sevenFunctionsReturn": { "const": true },
        "cliQueryResolve": { "const": true },
        "typescriptCompatible": { "const": true }
      }
    },
    "v2Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formalDescriptor",
        "nonEmptyInventory",
        "explicitProjectBinding",
        "contentBoundProjectFactsEvidence",
        "prepareOpaqueHandle",
        "strictResolve",
        "runMethodLock",
        "preExecutionReverify",
        "resolution",
        "selectionSource"
      ],
      "properties": {
        "formalDescriptor": { "const": true },
        "nonEmptyInventory": { "const": true },
        "explicitProjectBinding": { "const": true },
        "contentBoundProjectFactsEvidence": { "const": true },
        "prepareOpaqueHandle": { "const": true },
        "strictResolve": { "const": true },
        "runMethodLock": { "const": true },
        "preExecutionReverify": { "const": true },
        "resolution": { "const": "EXPLICIT_BINDING" },
        "selectionSource": { "const": "project-binding" }
      }
    },
    "locatableDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
