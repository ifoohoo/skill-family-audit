{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/quickstart-profile/v2/consumer-schema-inventory.json",
  "title": "Consumer Schema Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "schemaRoots", "schemas"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "skill-family.consumer-schema-inventory" },
    "schemaRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/containedPath" }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/schemaRecord" }
    }
  },
  "$defs": {
    "containedPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "schemaRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "$id", "disposition", "owner"],
      "properties": {
        "path": { "$ref": "#/$defs/containedPath" },
        "$id": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": ["foundation-bundle", "consumer-retained"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "exitCriterion"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "exitCriterion": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "foundation-bundle" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "owner": { "const": "foundation-bundle" },
              "retention": false
            }
          },
          "else": { "required": ["retention"] }
        }
      ]
    }
  }
}
