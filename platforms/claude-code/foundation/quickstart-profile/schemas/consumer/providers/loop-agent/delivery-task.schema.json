{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-agent:schema:delivery-task",
  "type": "object",
  "required": [
    "schema_version",
    "delivery_task_id",
    "delivery_cycle_id",
    "task_type",
    "workflow_package_path",
    "write_set",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "delivery_task_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "delivery_cycle_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "task_type": {
      "type": "string",
      "pattern": "\\S"
    },
    "reworks_task_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "predecessor_task_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "rework_order_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "ancestor_task_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "ancestor_workflow_package_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "workflow_package_path": {
      "type": "string",
      "pattern": "\\S"
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
