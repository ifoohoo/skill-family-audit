{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/candidate/quickstart-profile/v1/task.json",
  "title": "QuickstartTask",
  "description": "Candidate narrow profile over the stable operation-request envelope.",
  "allOf": [
    {
      "$ref": "https://contracts.skill-family.example/v1/operation-request.json"
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": {
            "name": "skill-family.quickstart-profile",
            "version": 1
          }
        },
        "operation": {
          "const": "audit"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "parameters", "inputs", "correlation"],
          "properties": {
            "method": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "parameters": {
              "type": "object"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "https://contracts.skill-family.example/candidate/quickstart-profile/v1/resource.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "location": {
                        "type": "object",
                        "required": ["path"],
                        "properties": {
                          "path": {}
                        }
                      },
                      "role": {
                        "const": "observation"
                      }
                    }
                  }
                ]
              }
            },
            "correlation": {
              "$ref": "#/$defs/correlation"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "stage", "attempt"],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "stage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
