{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/methods/conformance/result.json",
  "title": "Skill Family Audit conformance-audit domain result",
  "$defs": {
    "canonicalRuleId": {
      "type": "string",
      "pattern": "^SFA-[A-Z0-9]+-[0-9]{3}$"
    },
    "semanticGroupId": {
      "type": "string",
      "enum": [
        "artifact.assessment-layering",
        "artifact.capability-contract",
        "artifact.derived-projections",
        "artifact.identity-granularity",
        "artifact.internal-skill-binding",
        "artifact.method-contract-registry",
        "artifact.release-facts",
        "artifact.spec-rule-lifecycle",
        "audit.pipeline-release-summary",
        "audit.public-methods",
        "audit.readonly-control",
        "compatibility.adoption-state",
        "compatibility.strong-composition",
        "compose.ordering-parallelism",
        "compose.public-boundaries",
        "compose.repair-loop",
        "context.instruction-budget",
        "dependency.consumer-compatibility",
        "dependency.product-direction",
        "ecosystem.bridge-lifecycle",
        "ecosystem.extension-boundary",
        "ecosystem.product-roles",
        "ecosystem.single-graph",
        "entry.fixed-surfaces",
        "entry.quickstart-routing",
        "entry.task-validation-and-defaults",
        "extension.carrier-selection",
        "family.identity-capability",
        "foundation.engineering-kit",
        "foundation.quickstart-exchange",
        "foundation.terminology",
        "governance.machine-truth",
        "install.deactivation",
        "install.physical-cleanup",
        "install.recoverable-transaction",
        "method.public-surfaces",
        "method.registration",
        "migration.contract-adaptation",
        "migration.decision",
        "migration.lifecycle-boundaries",
        "migration.truth-and-portability",
        "platform.contract-parity",
        "platform.release-coverage",
        "profile.authoring-generation",
        "profile.domain-selection",
        "profile.logical-views",
        "program.runtime-contract",
        "publish.byte-chain",
        "publish.candidate-authorization",
        "publish.channel-qualification",
        "publish.licensing-authorship",
        "reference.adjudication",
        "reference.completion",
        "reference.lineage",
        "repair.audit-boundary",
        "repair.autofix",
        "repository.foundation-adoption",
        "repository.initial-layout",
        "repository.published-dependencies",
        "runtime.install-lifecycle-diagnostics",
        "runtime.mixed-boundary",
        "runtime.node-package",
        "runtime.python-package",
        "security.authorization",
        "security.crypto",
        "security.filesystem-write",
        "security.release-payload",
        "security.sensitive-data",
        "security.tools-network",
        "security.untrusted-input",
        "selfheal.bounded-recovery",
        "source.meaning-stability",
        "specification.audit-consumption",
        "specification.authority-layers",
        "state.execution-status",
        "supply.provenance",
        "topology.assistant-routing",
        "topology.domain-release",
        "topology.kernel-composer",
        "upstream.consumer-compatibility",
        "worker.execution-isolation",
        "worker.executor-topology",
        "worker.semantic-stage-responsibility"
      ]
    }
  },
  "description": "规范符合性检查方法的领域结果合同。full 单次覆盖 canonical inventory 全部 814 条规则：已激活规则保留 baseline lineage，保留规则使用不伪造基线载体的 canonical-only 试运行。逐规则结果以 EVIDENCE_MISSING/REVIEW_REQUIRED 表示未获证；外部语义审阅仅作为待审证据，其中任何状态（含 PASS）不直接改变顶层结论。规则选择前的输入/权威/目标绑定失败使用互斥早退分支（status=BLOCKED 且 failure_stage=before_rule_selection），不得输出假的规则集合、注册表摘要或完成比例；该分支只能由实际控制流设置，调用方不能选择。范围已经解析后的失败仍满足原完整字段。",
  "type": "object",
  "properties": {
    "conformance_result": {
      "type": "object",
      "description": "符合性审计领域结论。正常路径与已选出规则的失败保持原必填字段；仅尚未形成规则范围的失败可走 failure_stage=before_rule_selection 早退分支。",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "target_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_type": {
          "enum": [
            "single_skill",
            "family_source",
            "release_artifact",
            "project_adoption"
          ]
        },
        "platform": {
          "enum": [
            "all",
            "claude-code",
            "codex",
            "kimi-code",
            "workbuddy"
          ]
        },
        "rule_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "BLOCKED",
            "PARTIAL"
          ]
        },
        "failure_stage": {
          "const": "before_rule_selection",
          "description": "仅由实际控制流在规则范围尚未形成时设置；表示输入、权威或目标绑定失败。调用方不得通过参数选择该分支，正常结果出现该字段仍被拒绝。"
        },
        "execution_profile": {
          "type": "string",
          "enum": [
            "mechanical",
            "economy",
            "targeted",
            "full"
          ],
          "description": "本次执行的 profile；决定选择范围与 PARTIAL/SUCCEEDED 语义。"
        },
        "coverage": {
          "type": "object",
          "description": "可从逐规则结果与选择输入重新计算的覆盖摘要；rule_results 必须恰好包含每条 in-scope 规则一次，未选规则为 NOT_RUN。",
          "required": [
            "in_scope_rule_set_digest",
            "in_scope_count",
            "selected_rule_set_digest",
            "selected_count",
            "attempted_rule_set_digest",
            "attempted_count",
            "not_run_count",
            "coverage_complete",
            "conclusion_complete",
            "requested_semantic_group_ids",
            "requested_canonical_rule_ids",
            "selected_semantic_group_ids",
            "selected_deterministic_rule_count",
            "semantic_group_registry_digest"
          ],
          "properties": {
            "in_scope_rule_set_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "in_scope_count": {
              "type": "integer",
              "minimum": 0
            },
            "selected_rule_set_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selected_count": {
              "type": "integer",
              "minimum": 0
            },
            "attempted_rule_set_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "attempted_count": {
              "type": "integer",
              "minimum": 0
            },
            "not_run_count": {
              "type": "integer",
              "minimum": 0
            },
            "coverage_complete": {
              "type": "boolean"
            },
            "conclusion_complete": {
              "type": "boolean"
            },
            "requested_semantic_group_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/semanticGroupId"
              },
              "description": "调用方明确请求的语义组；非 targeted 时为空。"
            },
            "requested_canonical_rule_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/canonicalRuleId"
              },
              "description": "调用方明确请求的 canonical rule IDs；非 targeted 或语义组 targeted 时为空。"
            },
            "selected_semantic_group_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/semanticGroupId"
              }
            },
            "selected_deterministic_rule_count": {
              "type": "integer",
              "minimum": 0
            },
            "semantic_group_registry_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "semantic_preflight": {
          "type": "object",
          "description": "由当前运行在内存中完成逐规则预筛后投影出的组级摘要；不能产生语义 PASS/FAIL，也不重复 Task、证据集、规则集或 Registry 摘要。",
          "required": [
            "performed",
            "groups"
          ],
          "properties": {
            "performed": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "group_id",
                  "rule_count",
                  "applicable_rule_count",
                  "not_applicable_rule_count",
                  "undetermined_rule_count",
                  "ready_rule_count",
                  "missing_rule_count",
                  "review_required_rule_count",
                  "missing_evidence_roles"
                ],
                "properties": {
                  "group_id": {
                    "$ref": "#/$defs/semanticGroupId"
                  },
                  "rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "applicable_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_applicable_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "undetermined_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ready_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_evidence_roles": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "review_required_rule_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "execution_metrics": {
          "type": "object",
          "description": "本次运行实际观测到的语义执行成本，不是运行前估计值；mechanical 与 economy 的前四个语义执行计数必须为 0。",
          "required": [
            "semantic_model_call_count",
            "semantic_context_count",
            "estimated_input_tokens",
            "semantic_rules_sent_to_model_count",
            "semantic_rules_skipped_missing_evidence_count"
          ],
          "properties": {
            "semantic_model_call_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "本次运行实际发起的语义模型调用数；宿主实际观测未绑定时为 null，不得用 0 代替未知。"
            },
            "semantic_context_count": {
              "type": "integer",
              "minimum": 0,
              "description": "本次运行实际消费的语义上下文数。"
            },
            "estimated_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "本次运行实际消费上下文所对应的估算输入 token 数；字段名为既有合同名称。"
            },
            "semantic_rules_sent_to_model_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "本次运行实际发送给语义模型的规则数；宿主实际观测未绑定时为 null，不得从上下文结果数反推。"
            },
            "semantic_rules_skipped_missing_evidence_count": {
              "type": "integer",
              "minimum": 0,
              "description": "本次运行因缺少证据而实际跳过的语义规则数。"
            }
          },
          "additionalProperties": false
        },
        "reason_code": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "rule_results": {
          "type": "array",
          "uniqueItems": true,
          "description": "逐规则审阅结果。full 必须恰好输出 canonical inventory 的 814 个身份；保留规则不得伪造 baseline carrier。未获证规则必须保持 EVIDENCE_MISSING 或 REVIEW_REQUIRED，不得合成 PASS。",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "rule_revision_digest",
              "status"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "rule_revision_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "EVIDENCE_MISSING",
                  "REVIEW_REQUIRED",
                  "NOT_APPLICABLE",
                  "NOT_RUN"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "external_semantic_reviews": {
          "type": "array",
          "description": "调用方提交的外部语义审阅结果，仅作为待审证据记录；不构成可信来源证明。",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "rule_revision_digest",
              "status",
              "reason",
              "evidence"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "rule_revision_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "EVIDENCE_MISSING"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "semantic_review_binding": {
          "description": "本次 conformance Skill 内部审阅与 Foundation Task 的摘要绑定；null 表示没有内部审阅产物。身份绑定不证明认知独立。",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "producer_method_id": {
              "const": "skill-family-audit:conformance-audit"
            },
            "cognitive_independence": {
              "const": "not_attested"
            },
            "foundation_task_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "review_request_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence_set_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reviewed_rule_set_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "semantic_review_result_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "producer_method_id",
            "cognitive_independence",
            "foundation_task_digest",
            "review_request_digest",
            "evidence_set_digest",
            "reviewed_rule_set_digest",
            "semantic_review_result_digest"
          ],
          "additionalProperties": false
        },
        "canonical_rule_summary": {
          "type": "object"
        },
        "canonical_rule_applicability": {
          "type": "object"
        },
        "baseline_rule_set": {
          "type": "object"
        },
        "canonical_executable_coverage": {
          "type": "object"
        },
        "canonical_guidance": {
          "type": "object"
        },
        "method_assurance": {
          "type": "object",
          "required": [
            "total",
            "receipt_succeeded",
            "proven",
            "not_proven",
            "complete",
            "trusted_observation",
            "trusted_observed",
            "trusted_unavailable",
            "records"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "receipt_succeeded": {
              "type": "integer",
              "minimum": 0
            },
            "proven": {
              "type": "integer",
              "minimum": 0
            },
            "not_proven": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "const": false
            },
            "trusted_observation": {
              "type": "object",
              "required": [
                "kind",
                "schema_version",
                "run_id",
                "target_digest",
                "target_type",
                "platform",
                "rule_set_digest",
                "semantic_request_digest",
                "trust_projection_digest",
                "rule_results"
              ],
              "properties": {
                "kind": {
                  "const": "skill-family-audit.conformance-method-observation"
                },
                "schema_version": {
                  "const": "1.0.0"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "target_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "target_type": {
                  "enum": [
                    "single_skill",
                    "family_source",
                    "release_artifact",
                    "project_adoption"
                  ]
                },
                "platform": {
                  "enum": [
                    "all",
                    "claude-code",
                    "codex",
                    "kimi-code",
                    "workbuddy"
                  ]
                },
                "rule_set_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "semantic_request_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "trust_projection_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rule_results": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            },
            "trusted_observed": {
              "type": "integer",
              "minimum": 0
            },
            "trusted_unavailable": {
              "type": "integer",
              "minimum": 0
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "professional_consumption": {
          "type": "object",
          "description": "本次专业扫描、历史证明复用、版本政策与缺证汇总；与 Audit 自身规则发现分开。",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider_id",
                  "mode",
                  "status",
                  "reason"
                ],
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "scanned",
                      "reused_proof",
                      "version_policy",
                      "missing_proof",
                      "missing_entry",
                      "not_selected"
                    ]
                  },
                  "status": {
                    "enum": [
                      "pass",
                      "not_pass"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version_relation": {
                    "enum": [
                      "higher",
                      "lower",
                      "same",
                      "invalid",
                      "absent"
                    ]
                  },
                  "baseline_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proof_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reader_status": {
                    "enum": [
                      "pass",
                      "not_pass",
                      "unavailable",
                      null
                    ]
                  },
                  "entry_ref": {
                    "type": "string"
                  },
                  "does_not_certify_author": {
                    "type": "boolean"
                  },
                  "does_not_mean_rescan": {
                    "type": "boolean"
                  },
                  "refresh_suggested": {
                    "type": "boolean"
                  },
                  "conclusion": {
                    "description": "未经改写的原共同证明，含 subject、scope、outcome 及原发现与 limitations。",
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "BLOCKED"
              },
              "failure_stage": {
                "const": "before_rule_selection"
              }
            },
            "required": [
              "status",
              "failure_stage"
            ]
          },
          "then": {
            "required": [
              "status",
              "failure_stage",
              "reason_code",
              "summary"
            ],
            "properties": {
              "status": {
                "const": "BLOCKED"
              },
              "failure_stage": {
                "const": "before_rule_selection"
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "execution_profile": false,
              "coverage": false,
              "semantic_preflight": false,
              "execution_metrics": false,
              "rule_results": false,
              "canonical_rule_summary": false,
              "canonical_rule_applicability": false,
              "baseline_rule_set": false,
              "canonical_executable_coverage": false,
              "canonical_guidance": false,
              "method_assurance": false,
              "semantic_review_binding": false,
              "external_semantic_reviews": false
            }
          },
          "else": {
            "required": [
              "status",
              "execution_profile",
              "coverage",
              "semantic_preflight",
              "execution_metrics"
            ],
            "not": {
              "required": [
                "failure_stage"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "SUCCEEDED",
                        "FAILED",
                        "PARTIAL"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "schema_version": {},
                    "run_id": {},
                    "target_digest": {},
                    "target_type": {},
                    "platform": {},
                    "rule_set_digest": {},
                    "semantic_request_digest": {},
                    "rule_results": {},
                    "method_assurance": {},
                    "execution_profile": {},
                    "coverage": {},
                    "semantic_preflight": {},
                    "execution_metrics": {}
                  },
                  "required": [
