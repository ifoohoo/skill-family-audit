{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/foundation-mechanisms/v1/mechanism-batch-request.json",
  "title": "Candidate bounded mechanism batch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "inputs"],
  "properties": {
    "operation": { "const": "canonical-json" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document"],
        "properties": {
          "document": {}
        }
      }
    }
  }
}
