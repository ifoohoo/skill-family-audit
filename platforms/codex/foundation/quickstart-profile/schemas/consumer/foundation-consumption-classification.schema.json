{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/foundation-consumption-classification.json",
  "title": "Foundation consumption classification",
  "description": "Audit 领域的消费形态分类；只补充 Foundation profile 闭集之外的审计事实，不复制或替代 profile.json adoption 身份。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "consumptionForm",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "skill-family.foundation-consumption-classification"
    },
    "consumptionForm": {
      "enum": [
        "npm_exact_pin",
        "vendored_bundle",
        "bundle_projection"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/containedPath"
      }
    }
  },
  "$defs": {
    "containedPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
