{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/project-adoption-lock.json",
  "title": "ProjectAdoptionLock",
  "description": "Audit 领域合同：项目采用锁。从安装树存在性升级为封闭、机器可校验的 Foundation harness 生产切换审计绑定。每个字段必须由独立证据支撑；缺失或漂移均阻断。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family_id",
    "version",
    "candidate_id",
    "candidate_digest",
    "platform",
    "installed_root",
    "foundation_profile",
    "foundation_pin",
    "bundle_root",
    "bundle_provenance",
    "migration_manifest",
    "production_mechanisms",
    "harness_inventory",
    "owner_boundary",
    "adoption_route",
    "change_impact_closure",
    "migration_scope",
    "migration_checklist",
    "profile_composition",
    "generated_state_traceability"
  ],
  "properties": {
    "family_id": {
      "type": "string",
      "minLength": 1,
      "description": "采用的技能族标识符。"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "采用的候选版本号。"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[^:]+:.+",
      "description": "候选身份标识，格式 family_id:version。"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "安装树 payload 摘要（sha256 hex 64）。"
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "description": "安装平台标识符。"
    },
    "installed_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "description": "安装根的规范 POSIX 相对子目录路径；拒绝 '.'、绝对路径、'.'/'..' 组件、反斜杠、空组件和尾斜杠。"
    },
    "foundation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "stability"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation profile 标识符。"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Foundation profile 版本号。"
        },
        "stability": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation profile 稳定性等级。"
        }
      }
    },
    "foundation_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "digest"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation pin 文件相对于安装根的 POSIX 路径。"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Foundation pin 文件的 sha256 摘要。"
        }
      }
    },
    "bundle_root": {
      "type": "string",
      "minLength": 1,
      "description": "Foundation Bundle 根目录相对于安装根的 POSIX 路径。"
    },
    "bundle_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "digest", "payload_digest"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation provenance 文件相对于安装根的 POSIX 路径。"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Foundation provenance 文件的 sha256 摘要。"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Foundation Bundle payload 的 sha256 摘要。"
        }
      }
    },
    "migration_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "digest"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "description": "skill-family.migration.json 相对于安装根的 POSIX 路径。"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "migration manifest 文件的 sha256 摘要。"
        }
      }
    },
    "production_mechanisms": {
      "type": "array",
      "minItems": 1,
      "description": "本次采用涉及的生产机制或消费者 Schema ID 列表。集合必须非空、唯一、可从 pin 的 consumerSchemas 或显式生产入口机械闭合。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "harness_inventory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Foundation harness surface inventory receipt 绑定。receipt 由 Foundation verifyHarnessSurfaceInventory 机械校验，Audit 不自行 scan/hash/path。",
      "required": ["relative_path", "inventory_digest", "owner_adjudications"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation receipt 文件相对于项目根的 POSIX 路径。"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Foundation receipt 的 inventoryDigest，必须等于 Foundation proof.inventoryDigest。"
        },
        "owner_adjudications": {
          "type": "object",
          "additionalProperties": false,
          "description": "owner 裁决绑定（可选，也可通过 adjudication relative_path+digest 引用）。",
          "required": ["relative_path", "digest"],
          "properties": {
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "description": "owner 裁决文件的 POSIX 相对路径。"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "owner 裁决文件的 sha256 摘要。"
            }
          }
        }
      }
    },
    "owner_boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Foundation Harness、领域语义、Loop、release、audit 的 owner 边界声明。",
      "required": ["foundation_harness", "domain_semantics", "loop", "release", "audit"],
      "properties": {
        "foundation_harness": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation Harness 的 owner 标识。"
        },
        "domain_semantics": {
          "type": "string",
          "minLength": 1,
          "description": "领域语义的 owner 标识。"
        },
        "loop": {
          "type": "string",
          "minLength": 1,
          "description": "Loop 机制的 owner 标识。"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "description": "release 的 owner 标识。"
        },
        "audit": {
          "type": "string",
          "minLength": 1,
          "description": "audit 的 owner 标识。"
        }
      }
    },
    "adoption_route": {
      "type": "object",
      "additionalProperties": false,
      "description": "采用路由声明。new=scaffold（新技能族），existing=adopt-plan（既有技能族）。",
      "required": ["route_type", "is_new_skill_family"],
      "properties": {
        "route_type": {
          "type": "string",
          "enum": ["scaffold", "adopt-plan"],
          "description": "路由类型：scaffold 表示新技能族从 Foundation Engineering Kit scaffold 起步；adopt-plan 表示既有技能族制定迁移计划。"
        },
        "is_new_skill_family": {
          "type": "boolean",
          "description": "是否为新技能族。"
        },
        "scaffold_source": {
          "type": "string",
          "enum": ["foundation_engineering_kit", "manual", "unknown"],
          "description": "scaffold 来源。新技能族必须为 foundation_engineering_kit。"
        },
        "scaffold_target": {
          "type": "string",
          "minLength": 1,
          "description": "scaffold 目标目录的 POSIX 相对路径（新技能族必填）。通过 Engineering Kit export 探测 scaffoldTarget。"
        },
        "plan_adoption": {
          "type": "string",
          "minLength": 1,
          "description": "adopt-plan 路由的迁移计划文件 POSIX 相对路径（既有技能族必填）。通过现有 export 探测 planAdoption。"
        },
        "route_executable": {
          "type": "boolean",
          "description": "路由是否可执行（scaffold 入口存在或 adopt-plan 计划文件存在）。"
        },
        "engineering_kit_probe": {
          "type": "object",
          "additionalProperties": false,
          "description": "Foundation Engineering Kit 只读 export 探测结果（不执行写入 scaffold）。",
          "properties": {
            "entry_exists": {
              "type": "boolean"
            },
            "scaffold_function_exists": {
              "type": "boolean"
            },
            "probe_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "探测时入口文件的 sha256 摘要。"
            }
          }
        }
      }
    },
    "change_impact_closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "migration_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "migration_checklist": {
      "type": "object",
      "required": ["source_digest", "target_rules", "current_implementation", "compatibility", "adapters", "controlled_aliases", "behavior_verification", "deprecation", "owner"],
      "properties": {
        "source_digest": {}, "target_rules": {}, "current_implementation": {},
        "compatibility": {}, "adapters": {}, "controlled_aliases": {},
        "behavior_verification": {}, "deprecation": {}, "owner": {}
      }
    },
    "profile_composition": {
      "type": "object",
      "required": ["conflicts"],
      "properties": {"conflicts": {"type": "array"}}
    },
    "generated_state_traceability": {
      "type": "object",
      "required": ["human_selection", "project_extension", "method_binding", "domain_spec", "composer_version"],
      "properties": {
        "human_selection": {}, "project_extension": {}, "method_binding": {},
        "domain_spec": {}, "composer_version": {}
      }
    },
    "foundation_engineering_kit": {
      "type": "object",
      "additionalProperties": false,
      "description": "进程外 Foundation Engineering Kit 入口摘要（由验证器机械读取，不信任锁内自报）。",
      "properties": {
        "entry_path": {
          "type": "string",
          "minLength": 1,
          "description": "Foundation Engineering Kit 入口文件绝对路径。"
        },
        "entry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "入口文件的 sha256 摘要。"
        },
        "version": {
          "type": "string",
          "description": "Foundation Engineering Kit 版本号（从入口模块导出读取）。"
        }
      }
    }
  }
}
