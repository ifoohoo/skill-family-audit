{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/methods/conformance/parameters.json",
  "title": "Skill Family Audit conformance-audit parameters",
  "description": "规范符合性检查方法的领域参数合同。evidence_set 为必填闭合证据输入；target_project_path 仅为可选源码根提示，不得成为唯一输入。",
  "type": "object",
  "properties": {
    "evidence_set": {
      "type": "array",
      "minItems": 1,
      "description": "调用方提供的只读证据集合。每项证据带稳定 ID、种类、绝对规范路径和 SHA-256；摘要不符、符号链接、额外字段和未知类型由方法层失败关闭。",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "description": "证据稳定 ID；同一次请求内不得重复。"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source_tree",
              "source_file",
              "jsonl_conversation",
              "log",
              "manifest",
              "receipt",
              "policy",
              "exception",
              "platform_support"
            ],
            "description": "证据种类：源码树、源码文件、JSONL 对话、日志、manifest、receipt、policy、exception、platform support。"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "绝对规范路径；符号链接不被接受。"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "证据字节 SHA-256；源码树为规范树摘要。"
          }
        },
        "additionalProperties": false
      }
    },
    "target_project_path": {
      "type": "string",
      "description": "可选源码根提示；不得成为唯一输入。"
    },
    "scope_selector": {
      "type": "string",
      "enum": [
        "skill",
        "plugin",
        "release"
      ],
      "description": "受检对象范围"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "single_skill",
        "family_source",
        "release_artifact",
        "project_adoption"
      ],
      "description": "受检对象的真实目标类型，取入口实际参数。它与 scope_selector 分开，不使用 skill、plugin 或 release。"
    },
    "execution_profile": {
      "type": "string",
      "enum": [
        "mechanical",
        "economy",
        "targeted",
        "full"
      ],
      "description": "执行分支；缺省按 full 处理，保持直接调用合同。面向人入口必须显式传入。"
    },
    "semantic_group_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "artifact.capability-contract",
          "artifact.derived-projections",
          "artifact.identity-granularity",
          "artifact.internal-skill-binding",
          "artifact.method-contract-registry",
          "artifact.spec-rule-lifecycle",
          "compose.ordering-parallelism",
          "compose.public-boundaries",
          "context.instruction-budget",
          "dependency.consumer-compatibility",
          "dependency.product-direction",
          "ecosystem.bridge-lifecycle",
          "ecosystem.extension-boundary",
          "ecosystem.product-roles",
          "entry.fixed-surfaces",
          "entry.quickstart-routing",
          "entry.task-validation-and-defaults",
          "extension.carrier-selection",
          "family.identity-capability",
          "foundation.engineering-kit",
          "governance.machine-truth",
          "install.deactivation",
          "install.recoverable-transaction",
          "method.public-surfaces",
          "method.registration",
          "migration.contract-adaptation",
          "migration.lifecycle-boundaries",
          "migration.truth-and-portability",
          "platform.contract-parity",
          "platform.release-coverage",
          "profile.domain-selection",
          "program.runtime-contract",
          "publish.licensing-authorship",
          "repository.foundation-adoption",
          "runtime.install-lifecycle-diagnostics",
          "runtime.mixed-boundary",
          "runtime.python-package",
          "security.authorization",
          "security.sensitive-data",
          "selfheal.bounded-recovery",
          "source.meaning-stability",
          "state.execution-status",
          "topology.assistant-routing",
          "topology.domain-release",
          "upstream.consumer-compatibility",
          "worker.executor-topology",
          "worker.semantic-stage-responsibility"
        ]
      },
      "description": "仅 targeted 允许的非空、唯一、已登记语义组 ID 数组；其他 profile 或缺省（按 full 处理）传入失败。"
    },
    "canonical_rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SFA-[A-Z0-9]+-[0-9]{3}$"
      },
      "description": "仅 targeted 允许的非空、唯一 canonical rule ID 数组；与 semantic_group_ids 互斥。规则存在性与当前 scope 由运行时 canonical inventory 校验。"
    },
    "professional_consumption": {
      "$ref": "#/$defs/professionalConsumption",
      "description": "宿主选择、可定位证明和提供方读取器原始返回。完整档只在 late 或 final 的阶段参数中携带，不得写入 audit_input。基准由清单派生。未知字段拒绝。不得携带待执行命令，不得填写 status、version_relation、reader_status 等最终策略摘要。"
    },
    "audit_phase": {
      "type": "string",
      "enum": [
        "early",
        "late",
        "final"
      ],
      "description": "完整档领域阶段。early 只含已核实不消费专业结果的规则；late 等待对应专业终态；final 只组合原阶段结果。省略时不是完整档分阶段。"
    },
    "audit_input": {
      "type": "object",
      "description": "仅首个真实阶段内联的共同冻结输入。不得包含 professional_consumption 或证明正文。后续阶段不得再内联或倒填。",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "audit_version": {
          "type": "string",
          "minLength": 1
        },
        "target_root": {
          "type": "string",
          "minLength": 1
        },
        "target_project_path": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "scope_selector": {
          "type": "string",
          "minLength": 1
        },
        "execution_profile": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "professional_selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_set": {
          "type": "array"
        },
        "resource_closure": {
          "type": "object"
        },
        "executable_rules": {
          "type": "array"
        },
        "bindings": {
          "type": "array"
        },
        "selectors": {
          "type": "object"
        }
      }
    },
    "audit_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "audit_input 的 Foundation digest-document 摘要。不能代替正文，也不能手改。"
    },
    "audit_input_ref": {
      "type": "object",
      "description": "后续阶段和 final 对首个阶段已保存 audit_input 的 QuickstartResource 引用。",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "location",
        "role",
        "digest"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "role": {
          "const": "evidence"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "stage_rules": {
      "type": "array",
      "description": "本阶段精确规则方法子集。不能借用只允许 targeted 的 canonical_rule_ids。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_id",
          "revision_digest",
          "check_method",
          "binding_id"
        ],
        "properties": {
          "canonical_id": {
            "type": "string",
            "minLength": 1
          },
          "revision_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "check_method": {
            "type": "string",
            "minLength": 1
          },
          "binding_id": {
            "type": "string",
            "minLength": 1
          },
          "professional_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stage_results": {
      "type": "array",
      "minItems": 1,
      "description": "final 对原阶段 Task、Result、领域结果和 context 的引用。",
      "items": {
        "type": "object"
      }
    },
    "supersedes": {
      "type": "array",
      "description": "仅新的 late 阶段可携带。每项指向被误分配规则的原阶段和精确规则方法项。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_task_digest",
          "canonical_id",
          "revision_digest",
          "check_method",
          "binding_id"
        ],
        "properties": {
          "stage_task_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_id": {
            "type": "string",
            "minLength": 1
          },
          "revision_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "check_method": {
            "type": "string",
            "minLength": 1
          },
          "binding_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "professionalConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_id",
              "selected",
              "applicable",
              "entry_available",
              "action"
            ],
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "selected": {
                "type": "boolean"
              },
              "applicable": {
                "type": "boolean"
              },
              "entry_available": {
                "type": "boolean"
              },
              "action": {
                "enum": [
                  "none",
                  "refresh",
                  "reuse",
                  "scan"
                ]
              },
              "proof_root": {
                "type": "string",
                "minLength": 1
              },
              "proof_path": {
                "type": "string",
                "minLength": 1
              },
              "reader_result": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "pass",
                      "not_pass",
                      "unavailable"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "provider": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "conclusion": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "evidence_set",
    "scope_selector"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "audit_phase": {
            "const": "final"
          }
        },
        "required": [
          "audit_phase"
        ]
      },
      "then": {
        "properties": {
          "stage_results": {}
        },
        "required": [
          "stage_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_profile": {
            "const": "targeted"
          }
        },
        "required": [
          "execution_profile"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "semantic_group_ids": {}
            },
            "required": [
              "semantic_group_ids"
            ]
          },
          {
            "properties": {
              "canonical_rule_ids": {}
            },
            "required": [
              "canonical_rule_ids"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_profile": {
            "not": {
              "const": "targeted"
            }
          }
        },
        "required": [
          "execution_profile"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "properties": {
                "semantic_group_ids": {}
              },
              "required": [
                "semantic_group_ids"
              ]
            }
          },
          {
            "not": {
              "properties": {
                "canonical_rule_ids": {}
              },
              "required": [
                "canonical_rule_ids"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "execution_profile"
          ]
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "properties": {
                "semantic_group_ids": {}
              },
              "required": [
                "semantic_group_ids"
              ]
            }
          },
          {
            "not": {
              "properties": {
                "canonical_rule_ids": {}
              },
              "required": [
                "canonical_rule_ids"
              ]
            }
          }
        ]
      }
    }
  ]
}
