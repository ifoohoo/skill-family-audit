{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec/packages/skill-development/schemas/skill_rule_exception.schema.json",
  "title": "skill rule exception 制品",
  "description": "记录对应当前对象、规则和处理事项的特殊处理约定。批准、期限和其他条件按实际约定填写，不认证作者或批准真实性。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "target_object",
    "target_rule_id",
    "target_revision_digest",
    "scope",
    "treatment"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^exception:[a-z][a-z0-9-]+:[a-f0-9]{8}$",
      "description": "例外唯一标识"
    },
    "target_rule_id": {
      "type": "string",
      "description": "被例外的规则标识",
      "minLength": 1
    },
    "target_revision_digest": {
      "type": "string",
      "description": "被例外的规则修订摘要",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "例外范围"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "记录自身约定的截止时间；未约定时无需填写"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "description": "记录中已有的批准主体信息；不要求填写或认证"
    },
    "compensation": {
      "type": "string",
      "minLength": 1,
      "description": "补偿措施"
    },
    "revocation": {
      "type": "object",
      "description": "记录自身约定的撤销信息；未约定时无需填写",
      "additionalProperties": false,
      "required": [
        "revoker",
        "conditions",
        "evidence_ref"
      ],
      "properties": {
        "revoker": {
          "type": "string",
          "minLength": 1,
          "description": "有权撤销该例外的主体"
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "description": "触发撤销的条件"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "撤销证据引用；撤销发生时追加状态事实"
        }
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "失效条件：何种事实变化使例外提前失效（如规则修订变化、补偿失效、范围扩大）"
    },
    "status": {
      "type": "string",
      "description": "记录自身说明的状态，不作为统一审批生命周期或有效性结论",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "记录中已有的创建时间；未约定时无需填写"
    },
    "metadata": {
      "type": "object",
      "description": "可选元数据"
    },
    "target_object": {
      "type": "string",
      "minLength": 1,
      "description": "记录对应的当前对象"
    },
    "treatment": {
      "type": "string",
      "minLength": 1,
      "description": "约定的特殊处理事项"
    }
  }
}
