{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/skill-family-audit/candidate/v2/governance-gate-run-evidence.json",
  "title": "Governance gate run evidence",
  "description": "三项治理门禁的调用方冻结原始运行观察；Audit 只读取，不执行命令。",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "ruleId",
    "binding",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-candidate"
    },
    "kind": {
      "const": "skill-family-audit.governance-gate-run-evidence"
    },
    "ruleId": {
      "const": "SFA-GOVERNANCE-001"
    },
    "binding": {
      "type": "object",
      "required": [
        "target_version",
        "target_digest",
        "task_id",
        "platform",
        "environment"
      ],
      "properties": {
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "target_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "all",
            "claude-code",
            "codex",
            "kimi-code",
            "workbuddy"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ran",
          "argv",
          "cwd",
          "env",
          "input_refs",
          "stdout",
          "stderr",
          "exit_code",
          "conclusion"
        ],
        "properties": {
          "id": {
            "enum": [
              "artifact_drift",
              "entry_contract",
              "public_boundary"
            ]
          },
          "ran": {
            "type": "boolean"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "input_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "conclusion": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "undetermined"
            ]
          },
          "binding": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
