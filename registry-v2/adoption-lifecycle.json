    "transitions": [
      {
        "from": "v1_compatible",
        "to": "v2_candidate",
        "trigger": "v2_descriptor_inventory_binding_projection_complete",
        "conditions": [
          "descriptorComplete=true",
          "inventoryComplete=true",
          "bindingComplete=true",
          "projectionComplete=true"
