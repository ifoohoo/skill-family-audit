          "runtimeChainStatus=blocked_external_protocol"
        ]
      },
      {
        "from": "v2_candidate",
        "to": "v2_adopted",
        "trigger": "runtime_chain_passed",
        "conditions": [
          "runtimeChainStatus=passed",
          "all_eight_evidence_items=true"
        ]
      },
      {
        "from": "v2_runtime_blocked",
        "to": "v2_candidate",
        "trigger": "blocker_resolved",
        "conditions": [
          "external_blocker_removed"
        ]
      },
      {
        "from": "v2_adopted",
        "to": "v1_deprecated",
        "trigger": "healthy_adoption_window_completed",
        "conditions": [
          "runtimeChainStatus=passed",
          "twoDistinctConsumersPassed=true",
          "behaviorQualificationPassed=true",
          "noP0P1=true",
          "stabilizationPeriodCompleted=true",
          "rollbackDrillPassed=true"
        ]
      },
      {
        "from": "v2_adopted",
        "to": "rollback_window_open",
        "trigger": "v2_failure_detected",
        "conditions": [
          "explicit_user_or_governance_action"
        ]
      },
      {
        "from": "rollback_window_open",
        "to": "v1_compatible",
        "trigger": "rollback_executed",
        "conditions": [
          "rollbackTarget=v1_compatible",
          "rollbackAction=explicit_user_or_governance"
        ]
      },
      {
        "from": "rollback_window_open",
        "to": "v1_deprecated",
        "trigger": "window_close_conditions_met",
        "conditions": [
          "twoDistinctConsumersPassed=true",
          "behaviorQualificationPassed=true",
          "noP0P1=true",
          "stabilizationPeriodCompleted=true",
          "rollbackDrillPassed=true"
        ]
      },
      {
        "from": "v1_deprecated",
        "to": "v1_removed",
        "trigger": "deprecation_period_elapsed",
        "conditions": [
          "window_status=closed",
          "v1RemovalAllowed=true"
        ]
      },
      {
        "from": "v2_runtime_blocked",
        "to": "v1_compatible",
        "trigger": "explicit_rollback",
        "conditions": [
          "explicit_user_or_governance_action",
          "rollbackTarget=v1_compatible"
        ]
      }
    ],
    "constraints": {
      "noAdoptionWithoutFullRuntimeChain": "activeLevel=v2_adopted 时 runtimeChainStatus 必须为 passed 且全部八项证据为 true",
      "noSilentDowngrade": "silentDowngradeAllowed 必须为 false；v2 失败时不得自动通过 v1 继续执行",
      "noV1FallbackOnV2Failure": "v2Adoption.onFailure 必须为 stop_and_report，不得为 execute-v1",
      "rollbackOnlyToV1Compatible": "rollbackWindow.rollbackTarget 只能为 v1_compatible；回滚不得把 v1 当作 v2 执行替身",
      "v1RemovedOnlyAfterWindowClose": "v1_removed 只能在 rollbackWindow.status=closed 且全部关闭条件满足后发生",
      "noAdoptionWithExternalBlocker": "runtimeChainStatus=blocked_external_protocol 时 activeLevel 不得为 v2_adopted"
    }
